# Environment Variables for Bus Dorkar

# 1. PostgreSQL Database Connection URL (from Neon / Supabase / Railway / local Postgres)
# Format for Neon: postgresql://[user]:[password]@[ep-xyz].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Node Environment
NODE_ENV="development"

# 3. Optional: Web Push Notifications (PWA VAPID keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_public_vapid_key"
# VAPID_PRIVATE_KEY="your_private_vapid_key"
